---
interface Props {
  lang?: 'en' | 'fr';
}
const { lang = 'en' } = Astro.props;

const t = {
  en: {
    body: 'Your pet deserves the best. Find handpicked accessories and essentials in our dedicated shop.',
    go:   'Go',
    close: 'Close popup',
  },
  fr: {
    body: 'Votre animal mérite ce qu\'il y a de mieux. Retrouvez une sélection d\'accessoires et d\'essentiels dans notre boutique dédiée.',
    go:   'Visiter',
    close: 'Fermer',
  },
}[lang];
---

<div
  id="shop-popup"
  class="
    fixed top-[60px] right-4 z-40
    w-52 rounded-2xl
    bg-[#f5c9b0] dark:bg-[#3d2118]
    shadow-[0_8px_32px_rgba(0,0,0,0.18)]
    p-4 flex flex-col gap-4
    translate-x-0 opacity-100
    transition-all duration-300
  "
>
  <!-- Close button -->
  <button
    id="shop-popup-close"
    aria-label={t.close}
    class="
      absolute top-3 right-3
      w-7 h-7 rounded-full
      bg-[#c87941] dark:bg-[#a05e2e]
      border-0 cursor-pointer
      text-white text-base leading-none font-bold
      hover:bg-[#a85f2e] dark:hover:bg-[#c07030]
      transition-colors duration-200
      flex items-center justify-center
    "
  >×</button>

  <!-- Body text -->
  <p class="text-[#5c3020] dark:text-[#f0cdb8] text-sm leading-snug m-0 pr-5">
    {t.body}
  </p>

  <!-- Go button -->
  <a
    href="https://petcareshopbyjsputseva.vercel.app/"
    target="_blank"
    rel="noopener noreferrer"
    class="
      block w-full text-center
      rounded-xl
      bg-[#fde8d8] dark:bg-[#2a1208]
      text-[#7a4020] dark:text-[#f0c0a0]
      text-sm font-semibold
      py-2.5 no-underline
      hover:bg-[#ffba7e] dark:hover:bg-[#4a2010]
      hover:-translate-y-px
      active:translate-y-0
      transition-all duration-200
      shadow-sm hover:shadow-md
    "
  >
    {t.go} →
  </a>
</div>

<script>
  const popup  = document.getElementById('shop-popup');
  const closeBtn = document.getElementById('shop-popup-close');

  if (localStorage.getItem('petcare-shop-popup') === 'dismissed') {
    popup?.classList.add('hidden');
  }

  closeBtn?.addEventListener('click', () => {
    if (!popup) return;
    popup.classList.add('opacity-0', 'translate-x-4', 'pointer-events-none');
    setTimeout(() => popup.classList.add('hidden'), 300);
    localStorage.setItem('petcare-shop-popup', 'dismissed');
  });
</script>
